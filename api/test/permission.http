@url=http://localhost:4000

### Login
POST {{url}}/api/login
Content-Type: application/json

{
    "userId": "21013481",
    "password": "1111"
}

### Create group
POST {{url}}/api/groups
Content-Type: application/json

{
    "name": "admin",
    "description": "Người có chức vụ cao nhất trong hệ thống, người này có thể cấp và thu hồi quyền của các người dùng khác",
    "groupCode": "004"
}

### Get all group
GET {{url}}/api/groups

### Update group by id
PATCH {{url}}/api/groups/65d9fbf433cfcd55b534007f
Content-Type: application/json

{
    "groupCode": "003"
}
### Delete group
Delete {{url}}/api/groups/65d9f95033cfcd55b5340077

### Create role
POST {{url}}/api/roles
Content-Type: application/json

{
    "method": "patch",
    "url": "/page",
    "description": ""
}

### Delete role
DELETE {{url}}/api/roles/65d869e64f4c55561ee57878

